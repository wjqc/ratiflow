{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ratiflow.local/schemas/rpc-methods.json",
  "title": "Ratiflow JSON-RPC 方法清单（TS/Rust 类型生成的单一契约源）",
  "type": "object",
  "required": ["methods", "events"],
  "properties": {
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "params", "result"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z]+\\.[a-zA-Z]+$" },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "required"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string", "enum": ["string", "number", "boolean", "object", "array", "any"] },
                "required": { "type": "boolean" },
                "description": { "type": "string" }
              }
            }
          },
          "result": { "type": "string", "enum": ["void", "value"] }
        }
      }
    },
    "events": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
