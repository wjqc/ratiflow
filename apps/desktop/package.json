{
  "productName": "SixGates",
  "name": "@sixgates/desktop",
  "private": true,
  "version": "3.0.0",
  "main": "dist/main/main.js",
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --dir",
    "build:preload": "tsc -p tsconfig.preload.json",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "33.4.11",
    "electron-builder": "^25.0.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.49.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "description": "通关 SixGates — AI 软件交付工作台",
  "author": "SixGates"
}